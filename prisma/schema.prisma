  name                               String?                      @db.NVarChar(120)
  birth_year                         Int?
  gender                             String?                      @db.NVarChar(20)
  height_cm                          Decimal?                     @db.Decimal(5, 2)
  current_weight_kg                  Decimal?                     @db.Decimal(5, 2)
  goal_weight_kg                     Decimal?                     @db.Decimal(5, 2)
  goal_type                          String                       @db.NVarChar(20)
  goal_aggressiveness                String                       @default("N'moderate'", map: "df_users_goal_aggressiveness") @db.NVarChar(20)
  user_type                          String                       @default("N'common'", map: "df_users_user_type") @db.NVarChar(20)
  body_fat_percent                   Decimal?                     @db.Decimal(4, 1)
