{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "buildCommand": "npx prisma generate",
  "installCommand": "npm install",
  "outputDirectory": ".",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "assets/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
