generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev/Cloud Run's Debian container working; added for
  // Vercel's Node.js (AWS Lambda-based) serverless runtime, which needs its
  // own prebuilt query engine binary — without this, `prisma generate`
  // running on Vercel's build machine (Amazon Linux) produces a client with
  // no compatible engine for the actual Lambda execution environment.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model user_nutrition_profiles {
