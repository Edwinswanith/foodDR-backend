  "scripts": {
    "prisma:setup": "ts-node src/prisma-setup.ts",
    "prisma:generate": "npm run prisma:setup && prisma generate",
    "prisma:generate2": "npm run prisma:setup && prisma generate --schema=./prisma-postgres/schema.prisma",
    "prisma:migrate": "npm run prisma:setup && prisma migrate dev",
    "prisma:pull": "npm run prisma:setup && prisma db pull",
    "prisma:push": "npm run prisma:setup && prisma db push",
    "prisma:push2": "npm run prisma:setup && prisma db push --schema=./prisma-postgres/schema.prisma",
    "prisma:studio": "npm run prisma:setup && prisma studio",
    "prisma:reset": "npm run prisma:setup && prisma migrate reset",
    "prisma:deploy": "npm run prisma:setup && prisma migrate deploy",
    "tsc": "tsc",
    "watch-tsc": "tsc -w",
    "deploy": "node dist/server.js",
    "watch-deploy": "nodemon dist/server.js",
    "server": "concurrently --handle-input \"npm run watch-tsc\" \"npm run watch-deploy\"",
    "start": "npm run deploy",
    "heroku-postbuild": "npm run tsc",
    "dev": "nodemon --config nodemon.json src/server.ts",
    "dev:nutrition": "nodemon --exec \"node -r ts-node/register\" --ext ts,json src/dev-server.ts",
    "build": "rimraf dist && concurrently --handle-input \" npm run tsc\" ",
    "start:dev": "rimraf dist && concurrently --kill-others \"tsc -w\" \"wait-on dist/server.js && nodemon dist/server.js\"",
    "seed": "ts-node src/seedData/seed.ts",
    "copy-views": "copyfiles -u 1 src/api/views/**/* dist/views",
    "start:dev1": "rimraf dist && concurrently --kill-others \"tsc -w\" \"copyfiles -u 1 src/views/**/* dist/views -w\" \"wait-on dist/server.js && nodemon dist/server.js\"",
    "test": "jest --coverage",
    "type": "module"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ]
  },
