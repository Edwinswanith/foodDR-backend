{
  "name": "wms",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prisma:setup": "ts-node src/prisma-setup.ts",
    "prisma:generate": "npm run prisma:setup && prisma generate",
    "prisma:generate2": "npm run prisma:setup && prisma generate --schema=./prisma-postgres/schema.prisma",
    "prisma:migrate": "npm run prisma:setup && prisma migrate dev",
    "prisma:pull": "npm run prisma:setup && prisma db pull",
    "prisma:push": "npm run prisma:setup && prisma db push",
    "prisma:push2": "npm run prisma:setup && prisma db push --schema=./prisma-postgres/schema.prisma",
    "prisma:studio": "npm run prisma:setup && prisma studio",
    "prisma:reset": "npm run prisma:setup && prisma migrate reset",
    "prisma:deploy": "npm run prisma:setup && prisma migrate deploy",
    "postinstall": "prisma generate",
    "tsc": "tsc",
    "watch-tsc": "tsc -w",
    "deploy": "node dist/server.js",
    "watch-deploy": "node --watch dist/server.js",
    "server": "tsx watch src/server.ts",
    "start": "npm run dev:nutrition",
    "heroku-postbuild": "npm run tsc",
    "dev": "tsx watch src/server.ts",
    "dev:nutrition": "tsx watch src/dev-server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "start:dev": "tsx watch src/server.ts",
    "seed": "ts-node src/seedData/seed.ts",
    "test": "jest --config jest.nutrition.config.cjs --coverage",
    "test:nutrition": "jest --config jest.nutrition.config.cjs --runInBand",
    "type": "module"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.6",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.10",
    "@types/moment-timezone": "^0.5.13",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.6",
    "express-mysql-session": "^3.0.3",
    "jest": "^30.2.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.10.6",
    "@zxing/library": "^0.21.3",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "deepmerge": "4.1.1",
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "mysql2": "3.24.6",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
