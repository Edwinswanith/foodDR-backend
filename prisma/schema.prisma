  cuisine_preferences                String                       @default("N'[]'", map: "df_users_cuisine_preferences") @db.NVarChar(Max)
  dietary_restrictions               String?                      @db.NVarChar(Max)
  weight_unit                        String                       @default("N'kg'", map: "df_users_weight_unit") @db.NVarChar(4)
  timezone                           String                       @default("Asia/Kolkata", map: "df_unp_timezone") @db.NVarChar(60)
  glp1_mode                          Boolean                      @default(false, map: "df_users_glp1_mode")
  weekly_calorie_distribution        String?                      @db.NVarChar(Max)
  completed_tours                    String                       @default("N'[]'", map: "df_users_completed_tours") @db.NVarChar(Max)
  dismissed_nudges_json              String                       @default("N'{}'", map: "df_users_dismissed_nudges") @db.NVarChar(Max)
  recovery_is_active                 Boolean                      @default(false, map: "df_users_recovery_active")
  recovery_trigger_date              DateTime?                    @db.Date
  recovery_current_phase             Int                          @default(0, map: "df_users_recovery_phase")
  recovery_phase_start_date          DateTime?                    @db.Date
  recovery_meals_logged_since_return Int                          @default(0, map: "df_users_recovery_meals")
  org_id                             Int?
  height_unit                        String                       @default("N'cm'", map: "df_users_height_unit") @db.NVarChar(4)
  primary_goal                       String?                      @db.NVarChar(30)
  secondary_goal                     String?                      @db.NVarChar(30)
  health_conditions                  String?                      @db.NVarChar(Max)
  energy_level                       Int?
  meals_per_day                      Int?
  water_intake                       Decimal?                     @db.Decimal(5, 2)
  water_intake_unit                  String?                      @db.NVarChar(4)
  bmr                                Decimal?                     @db.Decimal(7, 2)
  tdee                               Decimal?                     @db.Decimal(7, 2)
  bmr_method_used                    String?                      @db.NVarChar(60)
  created_by                         String?                      @db.NVarChar(64)
  is_active                          Boolean                      @default(true, map: "df_users_is_active")
  created_at                         DateTime                     @default(dbgenerated("sysdatetimeoffset()"), map: "df_users_created_at") @db.DateTimeOffset
  updated_at                         DateTime                     @default(dbgenerated("sysdatetimeoffset()"), map: "df_users_updated_at") @updatedAt @db.DateTimeOffset
  user_id                            String?                      @db.NVarChar(64)
  is_deleted                         Boolean                      @default(false, map: "df_user_nutrition_profiles_is_deleted")
  unix_timestamp                     String?                      @db.NVarChar(20)
  onboarding_completed               Boolean                      @default(false, map: "df_unp_onboarding_completed")
  last_weight_update_date            DateTime?                    @db.Date
  current_weight_lbs                 Decimal?                     @db.Decimal(5, 2)
  goal_weight_lbs                    Decimal?                     @db.Decimal(5, 2)
  last_status_message_index          Int?
  workout_days_per_week              Int?                         @db.TinyInt
  last_seen_at                       DateTime?
  last_foreground_at                 DateTime?
  achievements                       achievements[]
  ai_cost_logs                       ai_cost_logs[]
  ai_meal_cache                      ai_meal_cache[]
  byte_events                        byte_events[]
  coach_messages                     coach_messages[]
  daily_stats                        daily_stats[]
  meals                              meals[]
  notification_log                   notification_log[]
  notification_preferences           notification_preferences?
  routines                           routines[]
  user_nutrition_plans               user_nutrition_plans[]
  weekly_nutrition_snapshots         weekly_nutrition_snapshots[]

  @@map("user_nutrition_profiles")
}

model nutrition_masters {
  id             String   @id(map: "PK__nutritio__3213E83F978B3997") @db.NVarChar(64)
  category       String   @db.NVarChar(30)
  value          String   @db.NVarChar(60)
  label          String   @db.NVarChar(120)
  org_id         Int?
  is_active      Boolean  @default(true, map: "df_nutrition_masters_active")
  created_at     DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "df_nutrition_masters_created") @db.DateTimeOffset
  updated_at     DateTime @default(dbgenerated("sysdatetimeoffset()"), map: "df_nutrition_masters_updated") @updatedAt @db.DateTimeOffset
  unix_timestamp String?  @db.NVarChar(20)
  is_deleted     Boolean  @default(false, map: "df_nutrition_masters_is_deleted")

  @@unique([category, value, org_id], map: "uq_nutrition_masters_category_value_org")
  @@index([category, is_active], map: "idx_nutrition_masters_category")
  @@map("nutrition_masters")
}

