  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-mints a fresh, valid tsconfig-scheme token before every request in",
          "// this collection, so there is never a manual \"copy token, paste it,",
          "// re-mint when it expires\" step, and nothing else in the workspace (an",
          "// unrelated \"Client Login\" request, a stray script) can silently overwrite",
          "// `token` with something incompatible.",
          "//",
          "// Ported 1:1 from scripts/mint-tsconfig-token.js — same CryptoJS AES",
          "// encryption of the inner payload, same manually-built HS256 JWT (Postman's",
          "// sandbox has no `jsonwebtoken` package, so the header.payload.signature",
          "// construction is done by hand here) — verified byte-for-byte against the",
          "// real server's jwt.verify() before being added to this collection.",
          "//",
          "// Wrapped in an IIFE: Postman/Newman reuse the same JS scope across every",
          "// request's pre-request script in a run, so top-level `const`/`let` here",
          "// would throw \"Identifier has already been declared\" on the second request.",
          "(function () {",
          "  var CryptoJS = require('crypto-js');",
          "",
          "  var userId = pm.environment.get('user_id') || pm.collectionVariables.get('user_id');",
          "  var jwtSecretKey = pm.environment.get('jwt_secret_key') || pm.collectionVariables.get('jwt_secret_key');",
          "  var cryptoPayloadSecretKey = pm.environment.get('crypto_payload_secret_key') || pm.collectionVariables.get('crypto_payload_secret_key');",
          "",
          "  if (!userId || !jwtSecretKey || !cryptoPayloadSecretKey) {",
          "    console.warn('[auto-auth] Skipped: set user_id / jwt_secret_key / crypto_payload_secret_key in the active environment first.');",
          "    return;",
          "  }",
          "",
          "  function base64url(input, isWordArray) {",
          "    var b64 = isWordArray ? CryptoJS.enc.Base64.stringify(input) : CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(input));",
          "    return b64.replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
          "  }",
          "",
          "  var innerPayload = JSON.stringify({ userId: userId, orgId: 1, device: 'web' });",
          "  var encryptedData = CryptoJS.AES.encrypt(innerPayload, cryptoPayloadSecretKey).toString();",
          "",
          "  var exp = Math.floor(Date.now() / 1000) + 3600;",
          "  var header = { alg: 'HS256', typ: 'JWT' };",
          "  var outerPayload = { data: encryptedData, exp: exp };",
          "",
          "  var headerB64 = base64url(JSON.stringify(header));",
          "  var payloadB64 = base64url(JSON.stringify(outerPayload));",
          "  var signingInput = headerB64 + '.' + payloadB64;",
          "  var signature = base64url(CryptoJS.HmacSHA256(signingInput, jwtSecretKey), true);",
          "  var token = signingInput + '.' + signature;",
          "",
          "  var target = pm.environment.name ? pm.environment : pm.collectionVariables;",
          "  target.set('token', token);",
          "})();",
          ""
        ]
      }
    }
  ]
}
