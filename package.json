{
  "name": "wms",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prisma:setup": "ts-node src/prisma-setup.ts",
    "prisma:generate": "npm run prisma:setup && prisma generate",
    "prisma:generate2": "npm run prisma:setup && prisma generate --schema=./prisma-postgres/schema.prisma",
    "prisma:migrate": "npm run prisma:setup && prisma migrate dev",
    "prisma:pull": "npm run prisma:setup && prisma db pull",
    "prisma:push": "npm run prisma:setup && prisma db push",
    "prisma:push2": "npm run prisma:setup && prisma db push --schema=./prisma-postgres/schema.prisma",
    "prisma:studio": "npm run prisma:setup && prisma studio",
    "prisma:reset": "npm run prisma:setup && prisma migrate reset",
    "prisma:deploy": "npm run prisma:setup && prisma migrate deploy",
    "tsc": "tsc",
    "watch-tsc": "tsc -w",
    "deploy": "node dist/server.js",
    "watch-deploy": "nodemon dist/server.js",
    "server": "concurrently --handle-input \"npm run watch-tsc\" \"npm run watch-deploy\"",
    "start": "npm run dev:nutrition",
    "heroku-postbuild": "npm run tsc",
    "dev": "nodemon --config nodemon.json src/server.ts",
    "dev:nutrition": "nodemon --exec \"node -r ts-node/register\" --ext ts,json src/dev-server.ts",
    "build": "rimraf dist && concurrently --handle-input \" npm run tsc\" ",
    "start:dev": "rimraf dist && concurrently --kill-others \"tsc -w\" \"wait-on dist/server.js && nodemon dist/server.js\"",
    "seed": "ts-node src/seedData/seed.ts",
    "copy-views": "copyfiles -u 1 src/api/views/**/* dist/views",
    "start:dev1": "rimraf dist && concurrently --kill-others \"tsc -w\" \"copyfiles -u 1 src/views/**/* dist/views -w\" \"wait-on dist/server.js && nodemon dist/server.js\"",
    "test": "jest --config jest.nutrition.config.cjs --coverage",
    "test:nutrition": "jest --config jest.nutrition.config.cjs --runInBand",
    "type": "module"
  },
  "jest": {
    "collectCoverage": true,
    "coverageReporters": [
      "lcov"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/express-mysql-session": "^3.0.6",
    "@types/express-session": "^1.18.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/lodash": "^4.17.10",
    "@types/moment-timezone": "^0.5.13",
    "@types/morgan": "^1.9.9",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.6",
    "@vercel/node": "^29.0.1",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.5",
    "express-mysql-session": "^3.0.3",
    "globals": "^15.11.0",
    "hbs": "^4.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "wait-on": "^7.1.0"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.9.11",
    "@zxing/library": "^0.21.3",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.46",
    "morgan": "^1.10.0",
    "mssql": "^11.0.1",
    "multer": "^2.5.0",
    "prisma": "^6.19.3",
    "socket.io": "^4.8.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
